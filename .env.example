# DatePlanner - variables d'environnement.
#
# Copier ce fichier en `.env` (développement) ou `.env.test` (tests), puis
# renseigner les valeurs. Aucune valeur n'est versionnée : ce fichier ne sert
# qu'à documenter ce que le service attend.

# Base PostgreSQL 17 (développement : dateplanner ; tests : dateplanner_test).
DATABASE_URL=

# Adresse publique du service. Production : https://dateplanner.laserit.fr
NEXT_PUBLIC_SITE_URL=

# Secret des signatures (cookie de la connexion Google, liens de désactivation
# du résumé). 32 octets aléatoires au moins.
APP_SECRET=

# Secret de l'appel de maintenance (Authorization: Bearer ...).
CRON_SECRET=

# Connexion Google (client OAuth du projet Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des emails : console (développement, tests), gmail (production), smtp.
EMAIL_DRIVER=
# gmail : adresse complète et mot de passe d'application ; smtp : identifiants.
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex. DatePlanner <notificationslaserit@gmail.com>
EMAIL_FROM=
# Pilote smtp seulement.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Anti-flood : 1 neutralise les compteurs hors production (sans effet en
# production). La liste exempte des adresses précises, séparées par des
# virgules, y compris en production.
RATE_LIMIT_DISABLED=
RATE_LIMIT_ALLOWLIST=
