# Les fichiers destinés au serveur Linux gardent des fins de ligne LF, quelle
# que soit la machine d'où ils sont écrits. Une unité systemd en CRLF casse la
# continuation de ligne, et rien ne le dit avant le premier passage manqué.
deploy/** text eol=lf
scripts/*.sh text eol=lf
scripts/lib/*.mjs text eol=lf
